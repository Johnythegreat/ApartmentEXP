rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function isWorkspaceAdmin(workspaceId) {
      return request.auth != null
        && request.auth.token.workspaceAdmin == true
        && request.auth.token.workspaceId == workspaceId;
    }

    // The tracker contains finances and resident PII. Never expose it publicly.
    match /budgetApp/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /apartments/{workspaceId} {
      allow read, write: if isAdmin() || isWorkspaceAdmin(workspaceId);
    }

    // Sanitized financial transparency view: readable without an account,
    // writable only by an administrator assigned to that apartment.
    match /publicApartmentViews/{workspaceId} {
      allow read: if true;
      allow write: if isAdmin() || isWorkspaceAdmin(workspaceId);
    }

    match /announcements/{id} {
      allow read: if isAdmin() || resource.data.status == 'published';
      allow create, update, delete: if isAdmin();
    }

    match /announcementSubscriptions/{id} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'status', 'createdAt', 'source'])
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 3
        && request.resource.data.email.size() <= 254
        && request.resource.data.status == 'pending'
        && request.resource.data.source == 'website';
      allow read, update, delete: if isAdmin();
    }

    match /notificationDeliveries/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
