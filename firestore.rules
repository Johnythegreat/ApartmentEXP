rules_version = '2'; service cloud.firestore { match /databases/{database}/documents { function isAdmin(){ return request.auth != null && request.auth.token.admin == true; } match /budgetApp/{docId}{ allow read, write: if true; } match /announcements/{id}{ allow read: if resource.data.status == 'published' || isAdmin(); allow create, update, delete: if isAdmin(); } match /announcementSubscriptions/{id}{ allow create: if request.resource.data.email is string && request.resource.data.email.size() < 255; allow read, update, delete: if isAdmin(); } match /notificationDeliveries/{id}{ allow read: if isAdmin(); allow write: if false; } } }
